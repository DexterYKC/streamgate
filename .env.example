# ================================
# StreamGate — Environment Variables
# Copy this file to .env and fill in your values.
# ================================

# ----- TELEGRAM -----
TELEGRAM_TOKEN=your_primary_bot_token_from_botfather
BOT_USERNAME=yourbotusername

# Secondary bot (optional — for redundancy/multi-bot)
TELEGRAM_TOKEN_2=your_second_bot_token
BOT_USERNAME_2=yoursecondbotusername

# ----- SERVER -----
BASE_URL=https://your-app.onrender.com
WEBHOOK_URL=https://your-app.onrender.com/telegram-webhook

# ----- ADMIN PANEL -----
ADMIN_CHAT_ID=your_telegram_user_id
ADMIN_PANEL_PASSWORD=choose_a_strong_password
ADMIN_SESSION_SECRET=random_32_char_string
ADMIN_TOTP_SECRET=optional_base32_secret_for_2fa

# ----- JWT (video tokens) -----
JWT_SECRET=random_32_char_string

# ----- ENCRYPTION -----
# Used to hash and encrypt Telegram IDs in storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_SALT=random_64_char_hex_string

# ----- GITHUB (subscriber database) -----
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_private_repo_name
GITHUB_FILE_PATH=bot/subscribers.json

# ----- PINATA (IPFS video storage) -----
PINATA_JWT=your_pinata_jwt_token

# ----- NOWPAYMENTS (crypto payments) -----
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# ----- OPTIONAL -----
# IPFS CID of your welcome animation (GIF/video shown on /start)
WELCOME_BANNER_CID=
